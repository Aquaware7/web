<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8' />
    <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.css' />
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.js'></script>
    <!-- 引入 Thunkable 官方提供的 Web Viewer 通訊輔助腳本 [citation:4] -->
    <script src="https://thunkable.github.io/webviewer-extension/thunkableWebviewerExtension.js" type="text/javascript"></script>
</head>
<body>

    <div id='calendar'></div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth', // 預設顯示月檢視
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                locale: 'zh-tw', // 設定為繁體中文
                firstDay: 1,      // 設定每週從週一開始
                height: 'auto',    // 讓高度自動適應，在手機上更好看

                // **重點 1：當使用者點擊某一天時，把日期傳回 Thunkable**
                dateClick: function(info) {
                    // 方法 A：透過改變網址的 hash (較簡單，適合傳遞單一資料)
                    // window.location.hash = info.dateStr;

                    // 方法 B：使用 Thunkable 專用的 postMessage (更強大，適合傳遞物件) [citation:2][citation:4]
                    // 這會觸發 Thunkable 中 Web Viewer 的「當接收訊息」事件
                    if (window.ThunkableWebviewerExtension) {
                        // 把日期包成一個物件，方便未來擴充
                        window.ThunkableWebviewerExtension.postMessage({
                            type: 'dateClick',
                            date: info.dateStr
                        });
                    }
                    console.log('Clicked date: ' + info.dateStr);
                },

                // **重點 2：顯示在月曆上的事件 (之後可以從 Google Sheet 讀取)**
                events: [
                    { title: '📅 開始專案', start: '2026-03-10' },
                    { title: '💡 會議', start: '2026-03-15' },
                    { title: '📝 繳交報告', start: '2026-03-20T10:00:00', end: '2026-03-20T12:00:00' }
                ]
            });
            calendar.render();

            // **重點 3：接收從 Thunkable App 傳來的訊息 (例如新增行程)**
            // 這個函數會被 Thunkable 的「呼叫 Javascript 函數」積木觸發
            window.receiveMessageFromApp = function(message) {
                console.log('收到來自 App 的訊息:', message);
                // 這裡可以解析 message，例如 { action: 'addEvent', title: '新行程', date: '2026-03-25' }
                // 然後動態新增一個事件到月曆上
                // calendar.addEvent({ title: message.title, start: message.date });
                alert('App 說：' + JSON.stringify(message));
            }
        });
    </script>
</body>
</html>
